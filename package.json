{
  "name": "jimha",
  "version": "2.0.0",
  "description": "Next-Gen Adaptive Sensory Playground for Toddlers",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:diff": "git diff --name-only --relative | grep -E '\\.(ts|svelte|js)$' | xargs -r eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:diff": "git diff --name-only --relative | grep -E '\\.(ts|svelte|js|json|md)$' | xargs -r prettier --write",
    "test": "vitest run",
    "test:diff": "vitest related --run",
    "test:watch": "vitest",
    "test:affected": "vitest related --run",
    "test:full": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "clippy:fix": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --fix --allow-dirty --allow-staged",
    "audit:deps": "pnpm audit --prod",
    "audit:pipeline": "bash scripts/audit_pipeline.sh",
    "verify:diff": "pnpm lint:diff && pnpm test:diff && pnpm clippy",
    "verify": "pnpm build && pnpm check && pnpm lint && pnpm clippy && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && pnpm test && pnpm test:rust",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --no-bundle"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2.12.4",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "simple-git-hooks": "^2.14.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  }
}
